{
  "regions": [
    "gru1"
  ],
  "functions": {
    "api/gerar.js": {
      "includeFiles": "templates/**"
    },
    "api/pdf.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ]
}
